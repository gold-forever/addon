# The BigWigs packager builds the addon from this repository (.github/workflows/addon-release.yml).
# move-folders lifts GoldForever/ and GoldForever_Auctions/ (the auction house panel, which the core
# loads on demand) to the package's root and registers them as the places the TOC files are read
# from; the tests and the repository's own files are left out.
package-as: GoldForever

enable-nolib-creation: no

# Written for players, not generated from the commit log.
manual-changelog:
  filename: GoldForever/CHANGELOG.md
  markup-type: markdown

move-folders:
  GoldForever/GoldForever: GoldForever
  GoldForever/GoldForever_Auctions: GoldForever_Auctions

ignore:
  - tests
  - tools
  - README.md
  - .github
